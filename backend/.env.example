# Server
PORT=5001
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173

# PostgreSQL Connection
PG_CONNECTION_STRING=postgresql://postgres:your_db_password@db.your-project-ref.supabase.co:5432/postgres
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=false
# Optional path to a custom CA certificate file for strict TLS verification
PG_CA_CERT_PATH=

# Authentication
JWT_SECRET=replace_with_a_strong_random_secret_key

# Supabase Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=replace_with_your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=album-images
